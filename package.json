{
  "name": "mykeep",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/regression.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "test:extension": "node --test tests/extension.test.mjs",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "test:backup": "node --test tests/scheduled-backup.test.mjs tests/backup-download.test.mjs",
    "build": "wrangler types && tsc --noEmit && vite build",
    "dev": "npm run build && wrangler dev",
    "db:local": "wrangler d1 migrations apply mykeep --local",
    "types": "wrangler types",
    "db:check": "node scripts/check-migrations.mjs",
    "deploy:checked": "npm run db:check && wrangler deploy",
    "deploy": "npm run build && npm run deploy:checked"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.18.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.142.0"
  }
}
