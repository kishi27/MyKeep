{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mykeep",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-28",
  "vars": {
    "AUTOMATIC_BACKUP_ENABLED": "true"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mykeep",
      "database_id": "60f91b7b-a15e-4455-9f2f-4a22ac32a85b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "mykeep-images"
    },
    {
      "binding": "BACKUPS",
      "bucket_name": "mykeep-backups"
    }
  ]
}
